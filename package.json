{
  "name": "sideby",
  "private": true,
  "version": "0.1.0",
  "description": "Netflix, multiplayer. Watch in sync with a friend whose camera floats over the movie.",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:ext": "pnpm --filter @sideby/extension dev",
    "dev:server": "pnpm --filter @sideby/server dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
